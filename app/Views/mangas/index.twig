<div class="page-head">
    <h1>Catálogo de mangás</h1>
    <span class="muted">{{ mangas|length }} título(s)</span>
</div>

<section class="card">
    <form class="filters" method="get" action="{{ url('/mangas') }}">
        <label>
            Buscar
            <input type="search" name="q" value="{{ search }}" placeholder="Título ou autor">
        </label>
        <label>
            Categoria
            <select name="category">
                <option value="">Todas</option>
                {% for category in categories %}
                    <option value="{{ category.id }}" {{ categoryId == category.id ? 'selected' : '' }}>{{ category.name }}</option>
                {% endfor %}
            </select>
        </label>
        <label>
            Tipo
            <select name="type">
                <option value="">Todos</option>
                {% for type in types %}
                    <option value="{{ type.id }}" {{ typeId == type.id ? 'selected' : '' }}>{{ type.name }}</option>
                {% endfor %}
            </select>
        </label>
        <div>
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
    </form>
</section>

<section class="section">
    {% if mangas is not empty %}
        <div class="grid-mangas">
            {% for manga in mangas %}
                {% include 'partials/manga-card.twig' with {manga: manga} only %}
            {% endfor %}
        </div>
    {% else %}
        <div class="empty">
            <div class="big">🔍</div>
            <p>Nenhum mangá encontrado com esses filtros.</p>
            <p><a class="see-all" href="{{ url('/mangas') }}">Limpar filtros</a></p>
        </div>
    {% endif %}
</section>
