{% set auth = auth|default({check: false, name: '', role: 'user', can_manage: false}) %}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title|default('Início') }} · {{ app_name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/site.css') }}">
</head>
<body>
<header class="topbar">
    <div class="container topbar-inner">
        <a href="{{ url('/') }}" class="brand"><span class="mark">B</span> {{ app_name }}</a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden>
        <label for="nav-toggle" class="nav-burger" aria-label="Abrir menu">
            <span></span><span></span><span></span>
        </label>

        <label for="nav-toggle" class="drawer-backdrop" aria-hidden="true"></label>

        <div class="topbar-menu">
            <div class="drawer-head">
                <span class="brand"><span class="mark">B</span> {{ app_name }}</span>
                <label for="nav-toggle" class="drawer-close" aria-label="Fechar menu">&times;</label>
            </div>

            <nav class="nav">
                <a href="{{ url('/') }}" class="{{ current_path == '/' ? 'active' : '' }}">Início</a>
                <a href="{{ url('/mangas') }}" class="{{ current_path starts with '/mangas' ? 'active' : '' }}">Catálogo</a>
            </nav>

            <form class="topbar-search search" action="{{ url('/mangas') }}" method="get">
                <input type="search" name="q" placeholder="Buscar mangás..." value="{{ search|default('') }}">
            </form>

            <div class="topbar-actions">
                {% if auth.check %}
                    {% if auth.can_manage %}
                        <a class="btn btn-ghost" href="{{ url('/admin') }}">Admin</a>
                    {% endif %}
                    <a class="btn btn-ghost" href="{{ url('/dashboard') }}">{{ auth.name|default('Conta') }}</a>
                    <form method="post" action="{{ url('/logout') }}">
                        <button type="submit" class="link-btn">Sair</button>
                    </form>
                {% else %}
                    <a class="btn btn-ghost" href="{{ url('/login') }}">Entrar</a>
                    <a class="btn btn-primary" href="{{ url('/register') }}">Criar conta</a>
                {% endif %}
            </div>
        </div>
    </div>
</header>

<main class="container">
    {{ content|raw }}
</main>

<footer class="footer">
    <div class="container footer-inner">
        <span>&copy; {{ year }} {{ app_name }} — Todos os direitos reservados.</span>
        <span>
            <a href="{{ url('/mangas') }}">Catálogo</a> ·
            <a href="{{ url('/login') }}">Entrar</a>
        </span>
    </div>
</footer>
</body>
</html>
