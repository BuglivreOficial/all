<div class="page-head">
    <h1>Editar autor</h1>
    <a class="btn-link" href="{{ url('/admin/authors') }}">&larr; Voltar</a>
</div>

<div class="alert alert-error" id="entity-alert" hidden></div>

<section class="card">
    <form id="entity-edit-form">
        <label>
            Nome
            <input type="text" name="name" maxlength="150" required autofocus>
        </label>

        <label>
            Biografia (opcional)
            <textarea name="bio" maxlength="3000"></textarea>
        </label>

        <p class="muted" style="font-size: 13px;">
            Slug (gerado automaticamente): <code id="entity-slug"></code>
        </p>

        <button type="submit">Salvar alterações</button>
    </form>
</section>
