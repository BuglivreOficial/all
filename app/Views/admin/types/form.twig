<div class="page-head">
    <h1>Editar tipo</h1>
    <a class="btn-link" href="{{ url('/admin/types') }}">&larr; Voltar</a>
</div>

<div class="alert alert-error" id="entity-alert" hidden></div>

<section class="card">
    <form id="entity-edit-form">
        <label>
            Nome
            <input type="text" name="name" maxlength="120" required autofocus>
        </label>

        <label>
            Descrição (opcional)
            <textarea name="description" maxlength="1000"></textarea>
        </label>

        <p class="muted" style="font-size: 13px;">
            Slug (gerado automaticamente): <code id="entity-slug"></code>
        </p>

        <button type="submit">Salvar alterações</button>
    </form>
</section>
