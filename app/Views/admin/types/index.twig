<div class="page-head">
    <h1>Tipos de mangá</h1>
</div>

{% if error %}<div class="alert alert-error">{{ error }}</div>{% endif %}
{% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
{% if errors is not empty %}<div class="alert alert-error">Corrija os campos destacados abaixo.</div>{% endif %}

<section class="card">
    <h2>Novo tipo</h2>
    <form method="post" action="{{ url('/admin/types') }}">
        <div class="form-grid">
            <div>
                <label>
                    Nome
                    <input type="text" name="name" maxlength="120" value="{{ old.name|default('') }}" required autofocus>
                </label>
                {% if errors.name is defined and errors.name|length %}
                    <div class="field-error">{{ errors.name[0] }}</div>
                {% endif %}
            </div>
            <div>
                <label>
                    Descrição (opcional)
                    <textarea name="description" maxlength="1000" placeholder="Breve descrição do tipo.">{{ old.description|default('') }}</textarea>
                </label>
                {% if errors.description is defined and errors.description|length %}
                    <div class="field-error">{{ errors.description[0] }}</div>
                {% endif %}
            </div>
        </div>
        <button type="submit">Criar tipo</button>
    </form>
</section>

<section class="card">
    <h2>Tipos cadastrados</h2>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Nome</th>
                <th>Slug</th>
                <th>Descrição</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            {% for type in types %}
                <tr>
                    <td>{{ type.id }}</td>
                    <td>{{ type.name }}</td>
                    <td class="muted">{{ type.slug }}</td>
                    <td class="muted">{{ type.description|excerpt(80) }}</td>
                    <td>
                        <span class="badge {{ type.is_active ? '' : 'badge-off' }}">
                            {{ type.is_active ? 'Ativo' : 'Inativo' }}
                        </span>
                    </td>
                    <td>
                        <div class="actions">
                            <a class="btn-link" href="{{ url('/admin/types/' ~ type.id ~ '/edit') }}">Editar</a>

                            <form method="post" action="{{ url('/admin/types/' ~ type.id ~ '/status') }}">
                                <button type="submit" class="btn-muted btn-sm">
                                    {{ type.is_active ? 'Desativar' : 'Ativar' }}
                                </button>
                            </form>

                            <form method="post" action="{{ url('/admin/types/' ~ type.id ~ '/delete') }}"
                                  onsubmit="return confirm('Excluir o tipo &quot;{{ type.name }}&quot;? Esta ação não pode ser desfeita.');">
                                <button type="submit" class="btn-danger btn-sm">Excluir</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="muted">Nenhum tipo cadastrado.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</section>
