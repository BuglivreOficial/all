<div class="page-head">
    <h1>Mangás</h1>
    <a class="btn btn-primary" href="{{ url('/admin/mangas/create') }}">+ Novo mangá</a>
</div>

<div class="alert alert-error" id="manga-alert" hidden></div>

<section class="card">
    <form method="get" id="manga-filters" class="form-grid">
        <div>
            <label>
                Buscar (título ou autor)
                <input type="text" name="q" placeholder="Digite para filtrar...">
            </label>
        </div>
        <div>
            <label>
                Categoria
                <select name="category">
                    <option value="">Todas</option>
                </select>
            </label>
        </div>
        <div>
            <label>
                Tipo
                <select name="type">
                    <option value="">Todos</option>
                </select>
            </label>
        </div>
        <div>
            <button type="submit">Filtrar</button>
        </div>
    </form>
</section>

<section class="card">
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Capa</th>
                <th>Título</th>
                <th>Tipo</th>
                <th>Categoria</th>
                <th>Autor</th>
                <th>Status</th>
                <th>Situação</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody id="manga-table-body">
            <tr><td colspan="9" class="muted">Carregando mangás…</td></tr>
        </tbody>
    </table>
</section>
