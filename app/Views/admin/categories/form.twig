<div class="page-head">
    <h1>Editar categoria</h1>
    <a class="btn-link" href="{{ url('/admin/categories') }}">&larr; Voltar</a>
</div>

{% if error %}<div class="alert alert-error">{{ error }}</div>{% endif %}

<section class="card">
    <form method="post" action="{{ url('/admin/categories/' ~ category.id) }}">
        <label>
            Nome
            <input type="text" name="name" maxlength="120" value="{{ old.name|default(category.name) }}" required autofocus>
        </label>
        {% if errors.name is defined and errors.name|length %}
            <div class="field-error">{{ errors.name[0] }}</div>
        {% endif %}

        <label>
            Descrição (opcional)
            <textarea name="description" maxlength="1000">{{ old.description|default(category.description) }}</textarea>
        </label>
        {% if errors.description is defined and errors.description|length %}
            <div class="field-error">{{ errors.description[0] }}</div>
        {% endif %}

        <p class="muted" style="font-size: 13px;">
            Slug (gerado automaticamente): <code>{{ category.slug }}</code>
        </p>

        <button type="submit">Salvar alterações</button>
    </form>
</section>
