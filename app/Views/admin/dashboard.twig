<section class="card">
    <div class="page-head">
        <h1>Dashboard</h1>
        <a class="btn btn-ghost" href="{{ url('/admin/mangas/create') }}">+ Novo mangá</a>
    </div>
    <p class="muted">
        Bem-vindo{% if auth.name %}, {{ auth.name }}{% endif %}.
        Você acessa esta área com o perfil
        <span class="badge">{{ role_labels[auth.role]|default(auth.role) }}</span>.
    </p>
</section>

<section class="card">
    <h2>Usuários recentes</h2>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Nome</th>
                <th>Usuário</th>
                <th>E-mail</th>
                <th>Perfil</th>
                <th>Desde</th>
            </tr>
        </thead>
        <tbody id="users-table-body">
            <tr><td colspan="6" class="muted">Carregando usuários…</td></tr>
        </tbody>
    </table>
</section>
