APP_NAME=BugLivre
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Bahia
# URL base para links absolutos (ex.: e-mail de redefinição de senha).
APP_URL=

# Modo de manutenção: com APP_MAINTENANCE=true o site fica indisponível
# (503) para o público. Perfis moderador+ logados continuam acessando.
APP_MAINTENANCE=false
APP_MAINTENANCE_MESSAGE=O site está temporariamente indisponível para manutenção. Voltamos em breve.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buglivre
DB_USERNAME=root
DB_PASSWORD=

# Tempo de vida do token de API em segundos (padrão: 30 dias)
AUTH_TOKEN_TTL=2592000

# Redefinição de senha: validade do link, em segundos (padrão: 1 hora)
PASSWORD_RESET_TTL=3600

# E-mail (SMTP via PHPMailer). Sem MAIL_HOST configurado, o envio não ocorre:
# o conteúdo é registrado no log (útil em desenvolvimento).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=BugLivre

# Redis (opcional). Com REDIS_ENABLED=false o limitador de taxa usa arquivos.
REDIS_ENABLED=false
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=
REDIS_PREFIX=buglivre:
REDIS_TIMEOUT=2.5
